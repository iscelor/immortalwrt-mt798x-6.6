#!/bin/sh /etc/rc.common
#
# procd wrapper for wapp-watchdog.sh: keeps wapp/bs20 alive after a crash.

START=99
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /sbin/wapp-watchdog.sh
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}
