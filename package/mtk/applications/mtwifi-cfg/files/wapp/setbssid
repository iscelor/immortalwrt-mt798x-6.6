#!/bin/sh
#
# Push the 802.11v neighbour list down to wapp: the candidate BSSIDs a client
# may be steered to, plus the operating channel advertised by this interface.
#
# usage: setbssid <ifname> <mac>[/<mac>...]
#
# `uci get` returns a space separated UCI list while older LuCI builds stored
# the value slash separated, accept both separators.
#

LOG_TAG="wapp-setbssid"

log_i() {
    logger -t "$LOG_TAG" "INFO: $*"
}

log_e() {
    logger -t "$LOG_TAG" "ERROR: $*"
}

run_cmd() {
    log_i "exec: $*"
    "$@"
    local rc=$?
    if [ "$rc" -eq 0 ]; then
        log_i "ok($rc): $*"
    else
        log_e "fail($rc): $*"
    fi
    return "$rc"
}

dev_band() {
    local dev="$1" band hw

    band="$(uci -q get wireless.$dev.band)"
    if [ -z "$band" ]; then
        hw="$(uci -q get wireless.$dev.hwmode)"
        case "$hw" in
            11a|11ac|11ax) band="5g" ;;
            11g|11b|11bg) band="2g" ;;
        esac
    fi

    case "$band" in
        2g|2.4g) echo "2g" ;;
        5g) echo "5g" ;;
        6g) echo "6g" ;;
    esac
}

iface="$1"
bssid="$2"

if [ -z "$iface" ] || [ -z "$bssid" ]; then
    log_e "invalid args: iface='$iface' bssid='$bssid'"
    exit 1
fi

if ! pidof wapp >/dev/null 2>&1; then
    log_e "wapp is not running, cannot apply neighbour list on $iface"
    exit 1
fi

# The band of the running interface decides which wifi-device channel to send.
case "$iface" in
    rax*) want_band="5g" ;;
    *) want_band="2g" ;;
esac

# nebor_op_ch must be the channel the *candidate* AP runs on, not this
# interface's own channel. Passing our own 149 made the driver look up
# (bssid, 149) in its scan table, miss the target sitting on 36 and drop the
# candidate entirely. The value now comes from the optional `steeringtargetch`
# option; when it is absent nothing is pushed and the driver resolves the
# channel from its own scan result.
channel=""
for iface_s in $(uci -q show wireless | sed -n 's/^wireless\.\([^.]*\)=wifi-iface$/\1/p'); do
    [ "$(dev_band "$(uci -q get wireless.$iface_s.device)")" = "$want_band" ] || continue
    chan="$(uci -q get wireless.$iface_s.steeringtargetch)"
    case "$chan" in
        ''|0|auto) continue ;;
    esac
    channel="$chan"
    break
done

if [ -n "$channel" ]; then
    run_cmd wappctrl "$iface" mbo nebor_op_ch "$channel"
else
    log_i "no steeringtargetch for band $want_band, let the driver resolve it"
fi

OLD_IFS="$IFS"
IFS=' /,'
for var in $bssid; do
    [ -n "$var" ] || continue
    case "$var" in
        [0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f]:[0-9A-Fa-f][0-9A-Fa-f])
            ;;
        *)
            log_e "skip invalid neighbour bssid '$var'"
            continue
            ;;
    esac
    log_i "apply neighbor bssid=$var on iface=$iface"
    run_cmd wappctrl "$iface" mbo nebor_bssid "$var"
    run_cmd wappctrl "$iface" mbo add_test_nr "$var"
done
IFS="$OLD_IFS"

log_i "setbssid done"
