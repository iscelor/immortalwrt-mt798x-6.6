+/*
+ * 802.11v BSS transition steering.
+ *
+ * MacTableMaintenance() runs from the one second MLME timer, that is in
+ * softirq context. A helper process must not be spawned from there: the
+ * strings passed to call_usermodehelper() are only guaranteed to be valid
+ * for the duration of the call when the helper is started asynchronously,
+ * and exec from atomic context is not allowed either. Queue the request on
+ * the system workqueue instead and keep the helper strings in static
+ * storage that is only rewritten while no request is outstanding.
+ */
+#define MTK_STEER_COOLDOWN_SEC	30
+#define MTK_STEER_HISTORY	16
+
+struct mtk_steer_hist {
+	UCHAR addr[MAC_ADDR_LEN];
+	ULONG last;
+};
+
+static DEFINE_SPINLOCK(mtk_steer_lock);
+static struct mtk_steer_hist mtk_steer_hist[MTK_STEER_HISTORY];
+static CHAR mtk_steer_path[] = "/sbin/steeringsta";
+static CHAR mtk_steer_ifname[IFNAMSIZ];
+static CHAR mtk_steer_mac[18];
+static CHAR *mtk_steer_argv[] = { mtk_steer_path, mtk_steer_ifname, mtk_steer_mac, NULL };
+static CHAR *mtk_steer_envp[] = { NULL };
+static atomic_t mtk_steer_busy = ATOMIC_INIT(0);
+
+static BOOLEAN mtk_steer_addr_is_set(UCHAR *addr)
+{
+	int i;
+
+	for (i = 0; i < MAC_ADDR_LEN; i++) {
+		if (addr[i])
+			return TRUE;
+	}
+
+	return FALSE;
+}
+
+/* Steer a given station at most once per cooldown window. */
+static BOOLEAN mtk_steer_rate_ok(UCHAR *addr)
+{
+	unsigned long flags;
+	ULONG now = jiffies;
+	int i, slot = -1;
+	BOOLEAN allow = FALSE;
+
+	spin_lock_irqsave(&mtk_steer_lock, flags);
+
+	for (i = 0; i < MTK_STEER_HISTORY; i++) {
+		if (MAC_ADDR_EQUAL(mtk_steer_hist[i].addr, addr)) {
+			slot = i;
+			break;
+		}
+
+		if ((slot < 0) && !mtk_steer_addr_is_set(mtk_steer_hist[i].addr))
+			slot = i;
+	}
+
+	if (slot >= 0) {
+		if (!mtk_steer_addr_is_set(mtk_steer_hist[slot].addr) ||
+		    time_after(now, mtk_steer_hist[slot].last + MTK_STEER_COOLDOWN_SEC * HZ)) {
+			NdisMoveMemory(mtk_steer_hist[slot].addr, addr, MAC_ADDR_LEN);
+			mtk_steer_hist[slot].last = now;
+			allow = TRUE;
+		}
+	}
+
+	spin_unlock_irqrestore(&mtk_steer_lock, flags);
+
+	return allow;
+}
+
+static void mtk_steer_work_handler(struct work_struct *work)
+{
+	int ret;
+
+	ret = call_usermodehelper(mtk_steer_path, mtk_steer_argv, mtk_steer_envp,
+				  UMH_WAIT_EXEC);
+	if (ret)
+		pr_info_ratelimited("steeringsta: cannot execute helper (%d)\n", ret);
+
+	atomic_set(&mtk_steer_busy, 0);
+}
+
+static DECLARE_WORK(mtk_steer_work, mtk_steer_work_handler);
+
+VOID MtkSteerCancelWork(VOID)
+{
+	cancel_work_sync(&mtk_steer_work);
+}
+
+static void mtk_steer_request(RTMP_ADAPTER *pAd, MAC_TABLE_ENTRY *pEntry,
+			      BSS_STRUCT *pMbss, CHAR avgRssi)
+{
+	const char *ifname = NULL;
+	unsigned long flags;
+
+	if (!pEntry->wdev)
+		return;
+
+	/* One outstanding request is enough, the worker clears the flag. */
+	if (atomic_cmpxchg(&mtk_steer_busy, 0, 1) != 0)
+		return;
+
+	if (!mtk_steer_rate_ok(pEntry->Addr)) {
+		atomic_set(&mtk_steer_busy, 0);
+		return;
+	}
+
+	if (pEntry->wdev->if_dev)
+		ifname = RTMP_OS_NETDEV_GET_DEVNAME(pEntry->wdev->if_dev);
+
+	if (!ifname || !ifname[0])
+		ifname = WMODE_CAP_2G(pEntry->wdev->PhyMode) ? "ra0" : "rax0";
+
+	spin_lock_irqsave(&mtk_steer_lock, flags);
+	snprintf(mtk_steer_ifname, sizeof(mtk_steer_ifname), "%s", ifname);
+	snprintf(mtk_steer_mac, sizeof(mtk_steer_mac), MACSTR, MAC2STR(pEntry->Addr));
+	spin_unlock_irqrestore(&mtk_steer_lock, flags);
+
+	MTWF_DBG(pAd, DBG_CAT_AP, DBG_SUBCAT_ALL, DBG_LVL_INFO,
+		 "802.11v steer "MACSTR" via %s, RSSI %d < %d\n",
+		 MAC2STR(pEntry->Addr), ifname, avgRssi, pMbss->SteeringThreshold);
+
+	schedule_work(&mtk_steer_work);
+}
