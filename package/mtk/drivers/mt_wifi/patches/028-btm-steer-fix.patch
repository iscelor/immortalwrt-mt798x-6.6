+/* ---- BtmSteer: a non-forced BTM Request carrying one candidate ---- */
+
+static UINT btm_steer_atoi(const char *s)
+{
+	UINT v = 0;
+
+	if (!s)
+		return 0;
+	while (*s >= '0' && *s <= '9') {
+		v = v * 10 + (UINT)(*s - '0');
+		s++;
+	}
+	return v;
+}
+
+static UCHAR btm_steer_hex(UCHAR c)
+{
+	if (c >= '0' && c <= '9')
+		return (UCHAR)(c - '0');
+	if (c >= 'a' && c <= 'f')
+		return (UCHAR)(c - 'a' + 10);
+	if (c >= 'A' && c <= 'F')
+		return (UCHAR)(c - 'A' + 10);
+	return 0xff;
+}
+
+static BOOLEAN btm_steer_parse_mac(const char *s, UCHAR *mac)
+{
+	INT i;
+	UCHAR hi, lo;
+
+	if (!s || strlen(s) != 17)
+		return FALSE;
+	for (i = 0; i < MAC_ADDR_LEN; i++) {
+		if (i < MAC_ADDR_LEN - 1 && s[i * 3 + 2] != ':')
+			return FALSE;
+		hi = btm_steer_hex((UCHAR)s[i * 3]);
+		lo = btm_steer_hex((UCHAR)s[i * 3 + 1]);
+		if (hi == 0xff || lo == 0xff)
+			return FALSE;
+		mac[i] = (UCHAR)((hi << 4) | lo);
+	}
+	return TRUE;
+}
+
+/*
+ * iwpriv rax0 set BtmSteer=<sta_mac>,<candidate_bssid>[,<channel>]
+ *
+ * The BTM body is built by the driver instead of wapp:
+ *   - request_mode = 0, i.e. a suggestion, not a forced disassociation
+ *   - one Neighbor Report candidate, so the client knows where to go
+ *   - channel is optional; when omitted compose_btm_req_ie resolves it from
+ *     the scan table
+ * wapp's "mbo steer_sta" never emits a frame and "btmreq" output differs per
+ * station, so neither is usable for automatic steering.
+ */
+INT Set_BtmSteer_Proc(PRTMP_ADAPTER pAd, RTMP_STRING *arg)
+{
+	POS_COOKIE pObj = (POS_COOKIE) pAd->OS_Cookie;
+	UCHAR ifIndex = pObj->ioctl_if;
+	UCHAR staAddr[MAC_ADDR_LEN];
+	UCHAR candAddr[MAC_ADDR_LEN];
+	btm_reqinfo_t *pInfo = NULL;
+	UCHAR *ieBuf = NULL;
+	UINT32 infoLen, ieLen = 0;
+	RTMP_STRING *tok;
+	INT idx;
+	BOOLEAN hasCand = FALSE;
+	MAC_TABLE_ENTRY *pEntry = NULL;
+	UINT ch = 0;
+
+	if (ifIndex >= pAd->ApCfg.BssidNum) {
+		MTWF_DBG(pAd, DBG_CAT_PROTO, CATPROTO_RRM, DBG_LVL_ERROR,
+			 "Unknown If index (%d)\n", ifIndex);
+		return FALSE;
+	}
+	if (!arg)
+		return FALSE;
+
+	NdisZeroMemory(staAddr, sizeof(staAddr));
+	NdisZeroMemory(candAddr, sizeof(candAddr));
+
+	idx = 0;
+	for (tok = rstrtok(arg, ","); tok && idx < 3;
+	     tok = rstrtok(NULL, ","), idx++) {
+		if (idx == 0) {
+			if (!btm_steer_parse_mac(tok, staAddr))
+				return FALSE;
+		} else if (idx == 1) {
+			if (!btm_steer_parse_mac(tok, candAddr))
+				return FALSE;
+			hasCand = TRUE;
+		} else {
+			ch = btm_steer_atoi(tok);
+		}
+	}
+	if (idx < 1)
+		return FALSE;
+
+	pEntry = MacTableLookup(pAd, staAddr);
+	if (!pEntry) {
+		MTWF_DBG(pAd, DBG_CAT_PROTO, CATPROTO_RRM, DBG_LVL_ERROR,
+			 "STA "MACSTR" not associated\n", MAC2STR(staAddr));
+		return FALSE;
+	}
+
+	infoLen = sizeof(btm_reqinfo_t) +
+		  (hasCand ? sizeof(struct nr_info) : 0);
+	os_alloc_mem(NULL, (UCHAR **)&pInfo, infoLen);
+	if (!pInfo)
+		return FALSE;
+	NdisZeroMemory(pInfo, infoLen);
+
+	COPY_MAC_ADDR(pInfo->sta_mac, staAddr);
+	pInfo->dialogtoken = 1;
+	pInfo->reqmode = 0;
+	pInfo->disassoc_timer = 0;
+	pInfo->valint = 200;
+	pInfo->num_candidates = hasCand ? 1 : 0;
+	if (hasCand) {
+		COPY_MAC_ADDR(pInfo->candidates[0].bssid, candAddr);
+		pInfo->candidates[0].channum = (UINT8)ch;
+		pInfo->candidates[0].preference = 1;
+	}
+
+	MlmeAllocateMemory(pAd, (PVOID)&ieBuf);
+	if (!ieBuf) {
+		os_free_mem(pInfo);
+		return FALSE;
+	}
+
+	compose_btm_req_ie(pAd, &pAd->ApCfg.MBSSID[ifIndex].wdev,
+			   ieBuf, &ieLen, pInfo, infoLen);
+	Send_BTM_Req(pAd, (RTMP_STRING *)staAddr, (RTMP_STRING *)ieBuf, ieLen);
+
+	MlmeFreeMemory(ieBuf);
+	os_free_mem(pInfo);
+	return TRUE;
+}
+
